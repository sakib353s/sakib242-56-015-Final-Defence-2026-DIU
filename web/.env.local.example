# CYBERWATCH-BD web console — environment template (copy to .env.local)
# API origin used by the dev proxy rewrites (/api/* → backend). Default: http://127.0.0.1:8471
CWB_API_ORIGIN=http://127.0.0.1:8471
# UNSUPPORTED with auth: the rotating refresh cookie is HttpOnly on the rewrite-proxy
# origin, so a cross-origin NEXT_PUBLIC_API_BASE makes /auth/refresh 401 → silent
# logout loop. The backend also ships no CORS middleware. Keep UNLESS you add both.
# NEXT_PUBLIC_API_BASE=http://127.0.0.1:8471
# Raw WebSocket base for /ws/boot /ws/alerts /ws/jobs (browsers cannot proxy WS through rewrites)
NEXT_PUBLIC_WS_BASE=ws://127.0.0.1:8471
