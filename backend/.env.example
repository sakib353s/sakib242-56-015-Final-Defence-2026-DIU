# CYBERWATCH-BD cwb-core env contract — copy to .env
CWB_ENV=lab                      # production = fail-closed on every missing secret/tool
CWB_HOST=0.0.0.0
CWB_PORT=8000
CWB_MONGO_URI=                   # atlas M0 srv string; required in production
CWB_CORS_ORIGINS=http://localhost:3000,https://cyberwatch.vercel.app
# external intel — ALL OPTIONAL: the platform runs fully on free no-key sources
# (HIBP breach registry, PwnedPasswords k-anon, NVD, crt.sh, RDAP, DNS, GitHub).
# No payment is ever required for any feature. Optional keys only widen coverage:
# HIBP key = exact per-account email search; Shodan = attack
# surface map; NVD key = higher rate limit.
CWB_HIBP_API_KEY=
CWB_SHODAN_API_KEY=
CWB_NVD_API_KEY=
# TOTP step-up gate: auto/off = skipped (audited) in lab, on = always prompt.
# Production ALWAYS enforces regardless of this value.
CWB_TOTP_ENFORCE=auto
# suricata
CWB_SURICATA_EVE_PATH=/var/log/suricata/eve.json
CWB_SURICATA_RULES_PATH=/etc/suricata/rules
CWB_BLOCK_AGENT_SCRIPT=          # host agent wrapping iptables (recommended)
# tor
CWB_TOR_CONTROL_HOST=127.0.0.1
CWB_TOR_CONTROL_PORT=9051
CWB_TOR_CONTROL_PASSWORD=
# production MUST inject these 5 (lab auto-generates data/secrets.json):
CWB_JWT_SECRET=
CWB_AUDIT_HMAC_KEY=
CWB_FIELD_ENC_KEY=
CWB_REPORT_SIGNING_KEY=
CWB_ENVELOPE_HMAC_KEY=
# immutable compliance constant (pins on first boot; set explicitly in production)
CWB_POLICY_HASH_CONSTANT=
